Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://5masters.ru%{REQUEST_URI} [R=301,L,NE]

# No duplicate /index.html URLs. THE_REQUEST excludes internal DirectoryIndex lookups.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Real generated directories use a trailing slash, preserving query strings.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# Serve actual files/directories first; never return the homepage for a missing asset.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# A missing public route gets the real 404 document and status, not a soft 404.
RewriteRule ^ - [R=404,L]

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>
